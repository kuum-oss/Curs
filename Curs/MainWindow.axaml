<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Curs.ViewModels" xmlns:views="using:Curs.Views" x:Class="Curs.MainWindow" x:DataType="vm:MainWindowViewModel" Title="{Binding Title}" Width="1480" Height="940" MinWidth="1100" MinHeight="740" Background="White" RequestedThemeVariant="Light">
 <Grid>
  <Grid IsVisible="{Binding ShowAuth}" Background="#F2F7F9" RowDefinitions="Auto,*"><StackPanel Margin="40" Spacing="8"><TextBlock Text="KanbanBoard" FontSize="28" FontWeight="Bold" Foreground="#168C98"/><TextBlock Text="Командне планування завдань" Classes="muted"/></StackPanel><Grid Grid.Row="1" Margin="0,0,0,60">
                <Border MaxWidth="480" Width="480" HorizontalAlignment="Center" IsVisible="{Binding ShowAuth}" Background="White" CornerRadius="16" Padding="32">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{Binding FormTitle}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Увійдіть, щоб працювати зі своїми дошками." Foreground="#58677D" TextWrapping="Wrap" />
                        <StackPanel Spacing="6" IsVisible="{Binding IsRegister}">
                            <TextBlock Text="Ім'я" />
                            <TextBox Name="NameInput" Text="{Binding Name, Mode=TwoWay}" Watermark="Ваше ім'я" IsEnabled="{Binding CanEdit}" MaxLength="100" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Email" />
                            <TextBox Name="EmailInput" Text="{Binding Email, Mode=TwoWay}" Watermark="name@example.com" IsEnabled="{Binding CanEdit}" MaxLength="254" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Пароль" />
                            <TextBox Name="PasswordInput" Text="{Binding Password, Mode=TwoWay}" PasswordChar="●" Watermark="Ваш пароль" IsEnabled="{Binding CanEdit}" MaxLength="72" />
                            <TextBlock IsVisible="{Binding IsRegister}" Text="Від 8 символів, до 72 байтів UTF-8." FontSize="12" Foreground="#58677D" />
                        </StackPanel>
                        <TextBlock IsVisible="{Binding HasError}" Text="{Binding Error}" Foreground="#B42318" TextWrapping="Wrap" />
                        <TextBlock IsVisible="{Binding IsBusy}" Text="Зачекайте…" Foreground="#58677D" />
                        <Button Name="SubmitButton" Content="{Binding SubmitLabel}" Command="{Binding SubmitCommand}" IsDefault="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="primary" Padding="16,12" />
                        <Button Name="SwitchButton" Content="{Binding SwitchLabel}" Command="{Binding SwitchCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
  </Grid></Grid>
  <Border IsVisible="{Binding IsSignedIn}"><views:BoardWorkspaceView DataContext="{Binding Workspace}"/></Border>
 </Grid>
</Window>
