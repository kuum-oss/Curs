<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Curs.ViewModels" xmlns:views="using:Curs.Views" x:Class="Curs.Views.StatisticsView" x:DataType="vm:BoardInsightsViewModel">

 <UserControl.Resources>
  <DataTemplate x:Key="Metric" x:DataType="vm:MetricViewModel"><Border Classes="kpi" Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,10,0" MinHeight="126"><Grid RowDefinitions="Auto,Auto,*"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><Border Classes="metric-icon" Background="White" CornerRadius="24" Width="34" Height="34"><PathIcon Data="{Binding Icon}" Foreground="{Binding Accent}" Width="20" Height="20"/></Border><TextBlock Classes="metric-title" Grid.Column="1" Text="{Binding Title}" FontSize="12" TextWrapping="Wrap" Foreground="#4B6080"/></Grid><WrapPanel Grid.Row="1" Margin="0,10,0,10"><TextBlock Classes="metric-value" Text="{Binding Value}" FontSize="28" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBlock Text="{Binding Change}" Foreground="{Binding ChangeColor}" FontSize="13"/></WrapPanel><TextBlock Classes="metric-note muted" Grid.Row="2" Text="{Binding Note}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Bottom"/></Grid></Border></DataTemplate>
  <DataTemplate x:Key="CompactMetric" x:DataType="vm:MetricViewModel"><Border Classes="kpi" Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,8,8" MinHeight="112"><Grid RowDefinitions="Auto,Auto,*"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><Border Classes="metric-icon" Background="White" CornerRadius="24" Width="28" Height="28"><PathIcon Data="{Binding Icon}" Foreground="{Binding Accent}" Width="20" Height="20"/></Border><TextBlock Classes="metric-title" Grid.Column="1" Text="{Binding Title}" FontSize="11" TextWrapping="Wrap" Foreground="#4B6080"/></Grid><WrapPanel Grid.Row="1" Margin="0,8,0,8"><TextBlock Classes="metric-value" Text="{Binding Value}" FontSize="24" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBlock Text="{Binding Change}" Foreground="{Binding ChangeColor}" FontSize="13"/></WrapPanel><TextBlock Classes="metric-note muted" Grid.Row="2" Text="{Binding Note}" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Bottom"/></Grid></Border></DataTemplate>
  <DataTemplate x:Key="Workload" x:DataType="vm:WorkloadViewModel"><Grid ColumnDefinitions="26,1.1*,1.3*,Auto" ColumnSpacing="10" Margin="0,8,0,0"><views:AvatarView DataContext="{Binding Avatar}" Width="26" Height="26"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/><ProgressBar Grid.Column="2" Value="{Binding Percent}" Maximum="100" Height="11" CornerRadius="8" Background="#EAF0F8" Foreground="#0095A5" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding Count}" FontSize="12" Classes="muted"/></Grid></DataTemplate>
  <DataTemplate x:Key="CompactWorkload" x:DataType="vm:WorkloadViewModel"><Grid ColumnDefinitions="26,110,*,Auto" ColumnSpacing="8" Margin="0,8,0,0"><views:AvatarView DataContext="{Binding Avatar}" Width="26" Height="26"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" MaxWidth="110" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/><ProgressBar Grid.Column="2" MinWidth="0" Value="{Binding Percent}" Maximum="100" Height="11" CornerRadius="8" Background="#EAF0F8" Foreground="#0095A5" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding Count}" FontSize="12" Classes="muted"/></Grid></DataTemplate>
  <DataTemplate x:Key="Recent" x:DataType="vm:ActivityViewModel"><Grid ColumnDefinitions="10,34,*" ColumnSpacing="10" Margin="0,12,0,4"><Border Width="7" Height="7" CornerRadius="7" Background="{Binding Accent}" VerticalAlignment="Top" Margin="0,8,0,0"/><Border Width="1" Background="#E5EBF4" VerticalAlignment="Stretch" Margin="0,20,0,-8"/><views:AvatarView Grid.Column="1" DataContext="{Binding Avatar}" Width="34" Height="34" VerticalAlignment="Top"/><StackPanel Grid.Column="2" Spacing="8"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><WrapPanel><TextBlock Text="{Binding Actor}" FontWeight="SemiBold" FontSize="11" Margin="0,0,5,0"/><TextBlock Text="{Binding Action}" FontSize="10" Classes="muted"/></WrapPanel><TextBlock Grid.Column="1" Text="{Binding When}" FontSize="10" Classes="muted"/></Grid><Grid ColumnDefinitions="*,18,*" ColumnSpacing="6"><Border Background="#EEF3FA" CornerRadius="5" Padding="8,5"><TextBlock Text="{Binding Before}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Before}"/></Border><TextBlock Grid.Column="1" Text="→" Classes="muted"/><Border Grid.Column="2" Background="{Binding AfterBackground}" CornerRadius="5" Padding="8,5"><TextBlock Text="{Binding After}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding After}"/></Border></Grid><Button Classes="ghost" Command="{Binding OpenCommand}" HorizontalAlignment="Left" Padding="0" MinHeight="22"><TextBlock Text="{Binding Title}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" MaxWidth="290"/></Button></StackPanel></Grid></DataTemplate>
 </UserControl.Resources>
 <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="12">
  <ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}" Height="3"/>
  <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Classes="error" TextWrapping="Wrap"/>
  <Border IsVisible="{Binding NeedsCompletion}" Background="#FFF8E5" CornerRadius="6" Padding="12"><TextBlock Text="Для підрахунку завершених задач оберіть колонку завершення у повному огляді. «У роботі» — активні задачі поза цією колонкою." TextWrapping="Wrap" FontSize="12" Foreground="#8B6A24"/></Border>
  <ItemsControl IsVisible="{Binding !$parent[views:StatisticsView].Compact}" ItemsSource="{Binding Metrics}" ItemTemplate="{StaticResource Metric}" Margin="0,0,-10,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
  <ItemsControl IsVisible="{Binding $parent[views:StatisticsView].Compact}" ItemsSource="{Binding Metrics}" ItemTemplate="{StaticResource CompactMetric}" Margin="0,0,-8,-8"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" Rows="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
  <Grid ColumnDefinitions="1.15*,1*" ColumnSpacing="16" IsVisible="{Binding !$parent[views:StatisticsView].Compact}">
   <Grid RowDefinitions="*,Auto" RowSpacing="16"><Border Classes="surface" Padding="16" MinHeight="206"><StackPanel Spacing="9"><TextBlock Text="Виконання за тиждень" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Кількість завершених задач" Classes="muted" FontSize="12"/><views:WeeklyChart Days="{Binding Days}" Height="140"/></StackPanel></Border><Border Grid.Row="1" Classes="surface" Padding="16"><StackPanel><TextBlock Text="Завантаженість команди" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Активні / усі призначені задачі" Classes="muted" FontSize="12" Margin="0,6,0,0"/><ItemsControl ItemsSource="{Binding Workload}" ItemTemplate="{StaticResource Workload}"/></StackPanel></Border></Grid>
   <Border Grid.Column="1" Classes="surface" Padding="16"><StackPanel><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Останні зміни" FontSize="17" FontWeight="SemiBold"/><Button Grid.Column="1" Content="Уся історія →" Classes="ghost" Command="{Binding HistoryCommand}" Foreground="#0095A5" Padding="0" FontSize="12"/></Grid><ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource Recent}"/><TextBlock Text="Поки немає змін." Classes="muted" IsVisible="{Binding !HasRecent}" Margin="0,20,0,0"/></StackPanel></Border>
  </Grid>
  <StackPanel Spacing="16" IsVisible="{Binding $parent[views:StatisticsView].Compact}"><Border Classes="surface" Padding="14"><StackPanel Spacing="8"><TextBlock Text="Виконання за тиждень" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Кількість завершених задач" Classes="muted" FontSize="11"/><views:WeeklyChart Days="{Binding Days}" Height="150"/></StackPanel></Border><Border Classes="surface" Padding="14"><StackPanel><TextBlock Text="Завантаженість команди" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Активні / усі призначені задачі" Classes="muted" FontSize="11" Margin="0,6,0,0"/><ItemsControl ItemsSource="{Binding Workload}" ItemTemplate="{StaticResource CompactWorkload}"/></StackPanel></Border></StackPanel>
  <TextBlock Text="{Binding TrackingNote}" Classes="muted" FontSize="10" TextWrapping="Wrap"/>
 </StackPanel></ScrollViewer>
</UserControl>
