<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Curs.Views.WelcomeBoardPreview" IsHitTestVisible="False" Focusable="False" Height="250" Opacity="0.8" ClipToBounds="True">
 <Border Background="White" CornerRadius="20" Padding="14" Margin="16,22,-8,-60" BoxShadow="0 8 24 0 #101D4250" RenderTransformOrigin="50%,50%"><Border.RenderTransform><RotateTransform Angle="-5"/></Border.RenderTransform>
  <Grid ColumnDefinitions="54,*,*,*" RowDefinitions="34,*">
   <Image Source="/Assets/kanbanboard.png" Width="36" Height="36"/>
   <Border Grid.Column="1" Grid.ColumnSpan="3" Background="#EFF3F7" CornerRadius="7" Margin="10,0,0,5"><TextBlock Text="Ваш наступний великий проєкт" FontSize="12" Foreground="#8693A7" Margin="12,0"/></Border>
   <StackPanel Grid.Row="1" Spacing="16" Margin="8,18,10,0"><Border Background="#E1E8EF" Height="7" CornerRadius="3"/><Border Background="#E1E8EF" Height="7" CornerRadius="3"/><Border Background="#E1E8EF" Height="7" CornerRadius="3"/></StackPanel>
   <Border Grid.Row="1" Grid.Column="1" Background="#EFF3FB" CornerRadius="9" Margin="8"><StackPanel Margin="12" Spacing="12"><TextBlock Text="Ідеї" FontWeight="Bold"/><Border Background="White" CornerRadius="8" Padding="10"><StackPanel Spacing="10"><Border Background="#D7E2FC" Height="7" Width="90" HorizontalAlignment="Left" CornerRadius="3"/><Border Background="#EBEEF4" Height="6" CornerRadius="3"/><Border Background="#EBEEF4" Height="6" Width="70" HorizontalAlignment="Left" CornerRadius="3"/><Border Background="#D3E0F4" Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Left"/></StackPanel></Border><Border Background="White" CornerRadius="8" Height="60"/></StackPanel></Border>
   <Border Grid.Row="1" Grid.Column="2" Background="#F0EEFB" CornerRadius="9" Margin="8"><StackPanel Margin="12" Spacing="12"><TextBlock Text="У процесі" FontWeight="Bold"/><Border Background="White" CornerRadius="8" Padding="10"><StackPanel Spacing="10"><Border Background="#FBE4AA" Height="7" Width="90" HorizontalAlignment="Left" CornerRadius="3"/><Border Background="#EBEEF4" Height="6" CornerRadius="3"/><Border Background="#EBEEF4" Height="6" Width="70" HorizontalAlignment="Left" CornerRadius="3"/><Border Background="#DEDAF5" Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Left"/></StackPanel></Border><Border Background="White" CornerRadius="8" Height="60"/></StackPanel></Border>
   <Border Grid.Row="1" Grid.Column="3" Background="#E3F4EF" CornerRadius="9" Margin="8"><StackPanel Margin="12" Spacing="12"><TextBlock Text="Готово" FontWeight="Bold"/><Border Background="White" CornerRadius="8" Padding="10"><StackPanel Spacing="10"><Border Background="#BDE5D2" Height="7" Width="90" HorizontalAlignment="Left" CornerRadius="3"/><Border Background="#EBEEF4" Height="6" CornerRadius="3"/><Border Background="#EBEEF4" Height="6" Width="70" HorizontalAlignment="Left" CornerRadius="3"/><Border Background="#C6E6DA" Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Left"/></StackPanel></Border><Border Background="White" CornerRadius="8" Height="60"/></StackPanel></Border>
  </Grid>
 </Border>
</UserControl>
