<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Curs.ViewModels" xmlns:views="using:Curs.Views" x:Class="Curs.Views.ContentDialogsView" x:DataType="vm:BoardContentViewModel"><Grid>
  <Border Classes="overlay" IsVisible="{Binding NewColumnVisible}"><Border Classes="modal" Width="430" Padding="26"><StackPanel Spacing="18"><TextBlock Text="Нова колонка" FontSize="23" FontWeight="SemiBold"/><TextBox Text="{Binding NewColumnName,Mode=TwoWay}" Watermark="Назва колонки" MaxLength="100" IsEnabled="{Binding CanEdit}"/><TextBlock Text="{Binding Error}" Classes="error"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Скасувати" Command="{Binding CancelNewColumnCommand}"/><Button Content="Створити" Classes="primary" Command="{Binding CreateColumnCommand}"/></StackPanel></StackPanel></Border></Border>
  <Border Classes="overlay" IsVisible="{Binding ColumnEditorVisible}"><Border Classes="modal" Width="450" Padding="26"><StackPanel Spacing="18"><TextBlock Text="Налаштування колонки" FontSize="23" FontWeight="SemiBold"/><TextBox Text="{Binding ColumnName,Mode=TwoWay}" MaxLength="100" IsEnabled="{Binding CanEdit}"/><TextBlock Text="{Binding Error}" Classes="error"/><Button Content="Видалити колонку" Classes="danger" Command="{Binding DeleteColumnCommand}" IsVisible="{Binding CanDeleteColumn}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Скасувати" Command="{Binding CloseEditorCommand}"/><Button Content="Зберегти" Classes="primary" Command="{Binding RenameColumnCommand}"/></StackPanel></StackPanel></Border></Border>
  <Border Classes="overlay" IsVisible="{Binding EditorVisible}" Padding="30"><Border Classes="modal" MaxWidth="900" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MaxHeight="780">
   <Grid RowDefinitions="Auto,*,Auto">
    <Border BorderBrush="#E7EBF1" BorderThickness="0,0,0,1" Padding="24,15"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="18"><TextBlock Text="Деталі картки" FontSize="16" FontWeight="SemiBold"/><Border Background="#E6F0FE" CornerRadius="6" Padding="10,4"><TextBlock Text="{Binding ColumnLabel}" Foreground="#4384CC" FontSize="11"/></Border></StackPanel><Button Grid.Column="1" Content="×" Classes="icon" Command="{Binding CloseEditorCommand}"/></Grid></Border>
    <ScrollViewer Grid.Row="1"><Grid ColumnDefinitions="2.2*,1*">
     <StackPanel Margin="24,12,24,16" Spacing="9">
      <TextBox Text="{Binding Title,Mode=TwoWay}" Watermark="Назва картки" FontSize="22" FontWeight="SemiBold" BorderThickness="0" Padding="0,2" MaxLength="200" IsEnabled="{Binding CanEdit}"/>
      <Border Name="CoverDropZone" Classes="photo-drop" MinHeight="70" IsVisible="{Binding ExistingCard}" DragDrop.AllowDrop="True" DragDrop.DragOver="CoverDragOver" DragDrop.DragLeave="CoverDragLeave" DragDrop.Drop="CoverDrop"><StackPanel><Button Classes="ghost" Command="{Binding ShowFullImageCommand}" IsVisible="{Binding HasCover}" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><Image Source="{Binding FullImage}" Height="160" Stretch="UniformToFill"/></Button><TextBlock Text="Перетягніть фото сюди · JPG, PNG, WEBP · до 5 МіБ" FontSize="11" Foreground="#168593" Margin="12,10" TextWrapping="Wrap" HorizontalAlignment="Center"/></StackPanel></Border>
      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10"><Button Content="▧  Змінити фото" Click="ChooseCover" IsEnabled="{Binding CanChangeCover}" Foreground="#168593" FontSize="12"/><Button Grid.Column="1" Content="Прибрати" Command="{Binding RemoveCoverCommand}" IsVisible="{Binding HasCover}" FontSize="12"/><TextBlock Grid.Column="2" Text="JPG, PNG, WEBP · до 5 МіБ" Classes="muted" FontSize="10" HorizontalAlignment="Right" TextWrapping="Wrap"/></Grid>
      <TextBlock Text="Збережіть нову картку, щоб додати фото та коментарі." Classes="muted" FontSize="11" IsVisible="{Binding !ExistingCard}" TextWrapping="Wrap"/>
      <TextBlock Text="Опис" FontWeight="SemiBold"/><TextBox Text="{Binding Description,Mode=TwoWay}" MaxLength="10000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="130" IsEnabled="{Binding CanEdit}" Watermark="Додайте опис завдання…"/>
      <StackPanel IsVisible="{Binding ExistingCard}" Spacing="12">
       <TextBlock Text="Коментарі" FontWeight="SemiBold" Margin="0,6,0,0"/>
       <ItemsControl ItemsSource="{Binding Comments}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:CommentItemViewModel"><Grid ColumnDefinitions="36,*" ColumnSpacing="12" Margin="0,0,0,8"><views:AvatarView DataContext="{Binding Avatar}" AttachedToVisualTree="AvatarAttached"/><Border Grid.Column="1" Classes="surface" Background="#FBFCFD" Padding="10,6"><StackPanel Spacing="5"><Grid ColumnDefinitions="Auto,*,24" ColumnSpacing="9"><TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding Date}" Classes="muted" FontSize="10"/><Button Grid.Column="2" Classes="icon" Content="⋯" Width="24" MinHeight="20" Height="20" Padding="0" FontSize="16"><Button.Flyout><MenuFlyout><MenuItem Header="Редагувати" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}"/><MenuItem Header="Видалити" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}"/></MenuFlyout></Button.Flyout></Button></Grid><TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"/></StackPanel></Border></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBox Text="{Binding CommentText,Mode=TwoWay}" Watermark="Написати коментар…" MaxLength="4000" IsEnabled="{Binding CanEdit}"/><Button Grid.Column="1" Content="Додати" Classes="primary" Command="{Binding AddCommentCommand}"/></Grid>
      </StackPanel>
     </StackPanel>
     <Border Grid.Column="1" Background="#FCFCFE" BorderBrush="#E7EBF1" BorderThickness="1,0,0,0" Padding="20,24"><StackPanel Spacing="12">
      <TextBlock Text="Пріоритет" Classes="label"/><ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority,Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
      <TextBlock Text="Дедлайн" Classes="label" Margin="0,10,0,0"/><CalendarDatePicker SelectedDate="{Binding CalendarDate,Mode=TwoWay}" Watermark="Оберіть дату" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch"/>
      <TextBlock Text="Відповідальний" Classes="label" Margin="0,10,0,0"/><ComboBox ItemsSource="{Binding Assignees}" SelectedItem="{Binding Assignee,Mode=TwoWay}" IsEnabled="{Binding CanEdit}"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:AssigneeOption"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Border IsVisible="{Binding HasAvatar}"><views:AvatarView DataContext="{Binding Avatar}" Width="26" Height="26" AttachedToVisualTree="AvatarAttached"/></Border><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <TextBlock Text="Теги" Classes="label" Margin="0,10,0,0"/>
      <ItemsControl ItemsSource="{Binding SelectedTags}" IsEnabled="{Binding CanEdit}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:TagChoiceViewModel"><Border Background="{Binding Background}" CornerRadius="5" Padding="8,3" Margin="0,0,6,6"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}" FontSize="12"/><Button Classes="icon" Content="×" Width="18" MinHeight="20" Height="20" Padding="0" FontSize="15" Command="{Binding RemoveCommand}" ToolTip.Tip="Прибрати тег"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Expander Header="＋ Додати тег" IsExpanded="False"><StackPanel Spacing="10"><ItemsControl ItemsSource="{Binding Tags}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:TagChoiceViewModel"><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected,Mode=TwoWay}" FontSize="12"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBox Text="{Binding TagName,Mode=TwoWay}" Watermark="Назва нового тегу" MaxLength="50" IsEnabled="{Binding CanEdit}"/><TextBox Text="{Binding TagColor,Mode=TwoWay}" Watermark="#64748B" MaxLength="7" IsEnabled="{Binding CanEdit}"/><Button Content="Створити тег" Command="{Binding CreateTagCommand}"/></StackPanel></Expander>
      <Button Content="{Binding ArchiveCardLabel}" Command="{Binding ArchiveCardCommand}" IsVisible="{Binding CanDeleteCard}" Margin="0,18,0,0"/>
     </StackPanel></Border>
    </Grid></ScrollViewer>
    <Border Grid.Row="2" BorderBrush="#E7EBF1" BorderThickness="0,1,0,0" Padding="24,12"><StackPanel Spacing="8"><TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Classes="error" FontSize="12"/><TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}" Classes="success" FontSize="11"/><Grid ColumnDefinitions="*,Auto"><Button Content="Видалити картку" Classes="danger" Command="{Binding DeleteCardCommand}" IsVisible="{Binding CanDeleteCard}"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"><Button Content="Скасувати" Command="{Binding CloseEditorCommand}"/><Button Content="Зберегти" Classes="primary" Command="{Binding SaveCardCommand}"/></StackPanel></Grid></StackPanel></Border>
   </Grid>
  </Border></Border>
  <Border Classes="overlay" IsVisible="{Binding FullImageVisible}"><Border Classes="modal" Padding="20"><Grid RowDefinitions="Auto,*"><Button Content="×  Закрити" Command="{Binding CloseFullImageCommand}" HorizontalAlignment="Right" Margin="0,0,0,12"/><Image Grid.Row="1" Source="{Binding FullImage}" Stretch="Uniform" MaxWidth="900" MaxHeight="650"/></Grid></Border></Border>
  <Border Classes="overlay" IsVisible="{Binding CommentEditorVisible}"><Border Classes="modal" Width="520" Padding="26"><StackPanel Spacing="18"><TextBlock Text="Редагувати коментар" FontSize="22" FontWeight="SemiBold"/><TextBox Text="{Binding EditCommentText,Mode=TwoWay}" MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" Height="140" IsEnabled="{Binding CanEdit}"/><TextBlock Text="{Binding Error}" Classes="error"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12"><Button Content="Скасувати" Command="{Binding CancelCommentCommand}"/><Button Content="Зберегти" Classes="primary" Command="{Binding SaveCommentCommand}"/></StackPanel></StackPanel></Border></Border>
  <Border Classes="overlay" IsVisible="{Binding CommentDeleteVisible}"><Border Classes="modal" Width="450" Padding="26"><StackPanel Spacing="18"><TextBlock Text="Видалити коментар?" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Цю дію неможливо скасувати." Classes="muted"/><TextBlock Text="{Binding Error}" Classes="error"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12"><Button Content="Скасувати" Command="{Binding CancelDeleteCommentCommand}"/><Button Content="Видалити" Classes="danger" Command="{Binding DeleteCommentCommand}"/></StackPanel></StackPanel></Border></Border>
  <Border Classes="overlay" IsVisible="{Binding ShowConfirmation}"><Border Classes="modal" Width="450" Padding="26"><StackPanel Spacing="18"><TextBlock Text="Підтвердження видалення" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding ConfirmationText}" TextWrapping="Wrap"/><TextBlock Text="{Binding Error}" Classes="error"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12"><Button Content="Скасувати" Command="{Binding CancelCommand}"/><Button Content="Видалити" Classes="danger" Command="{Binding ConfirmCommand}"/></StackPanel></StackPanel></Border></Border>

<Border Classes="overlay" IsVisible="{Binding DiscardChangesVisible}"><Border Classes="modal" Width="480" Padding="26"><StackPanel Spacing="18"><TextBlock Text="Відкинути незбережені зміни?" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Поля редактора ще не збережені. Можна повернутися до редагування або закрити його." TextWrapping="Wrap" Classes="muted"/><StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right"><Button Content="Продовжити редагування" Command="{Binding KeepEditorCommand}"/><Button Content="Відкинути" Classes="danger" Command="{Binding DiscardEditorCommand}"/></StackPanel></StackPanel></Border></Border>
</Grid></UserControl>
