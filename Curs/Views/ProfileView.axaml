<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Curs.ViewModels" xmlns:views="using:Curs.Views" x:Class="Curs.Views.ProfileView" x:DataType="vm:ProfileViewModel">
 <Grid>
 <ScrollViewer>
  <StackPanel MaxWidth="940" Margin="28" Spacing="16" HorizontalAlignment="Stretch">
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
    <StackPanel Spacing="6"><TextBlock Text="Мій профіль" Classes="heading"/><TextBlock Text="Особисті дані, фото та безпека облікового запису" Classes="muted" TextWrapping="Wrap"/></StackPanel>
    <Button Grid.Column="1" Content="Скасувати зміни" Command="{Binding ResetCommand}" VerticalAlignment="Center"/>
   </Grid>
   <TextBlock Text="{Binding Error}" Classes="error" IsVisible="{Binding HasError}"/>
   <TextBlock Text="{Binding Status}" Classes="success" IsVisible="{Binding HasStatus}"/>
   <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
    <StackPanel Spacing="16">
     <Border Classes="surface" Padding="20"><StackPanel Spacing="14">
      <TextBlock Text="Фото профілю" FontWeight="SemiBold" FontSize="18"/>
      <Grid ColumnDefinitions="74,*" ColumnSpacing="16">
       <views:AvatarView DataContext="{Binding Avatar}" Width="72" Height="72"/>
       <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Змінити фото" Click="ChooseAvatar" IsEnabled="{Binding CanEdit}"/><Button Content="Прибрати" Command="{Binding DeleteAvatarCommand}"/></StackPanel>
        <TextBlock Text="JPG, PNG, WEBP · до 5 МіБ" Classes="muted" FontSize="12"/>
       </StackPanel>
      </Grid>
     </StackPanel></Border>
     <Border Classes="surface" Padding="20"><StackPanel Spacing="10">
      <TextBlock Text="Особисті дані" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="Ім’я" Classes="label"/><TextBox Name="ProfileNameInput" Text="{Binding Name,Mode=TwoWay}" MaxLength="100" IsEnabled="{Binding CanEdit}"/>
      <TextBlock Text="Email" Classes="label"/><TextBox Name="ProfileEmailInput" Text="{Binding Email,Mode=TwoWay}" MaxLength="254" IsEnabled="{Binding CanEdit}"/>
      <TextBlock Text="Для зміни email введіть поточний пароль праворуч." Classes="muted" FontSize="12" TextWrapping="Wrap"/>
      <Button Content="Зберегти профіль" Classes="primary" Command="{Binding SaveCommand}"/>
     </StackPanel></Border>
    </StackPanel>
    <Border Grid.Column="1" Classes="surface" Padding="20" VerticalAlignment="Top"><StackPanel Spacing="10">
     <TextBlock Text="Змінити пароль" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock Text="Поточний пароль" Classes="label"/><TextBox Name="CurrentPasswordInput" Text="{Binding CurrentPassword,Mode=TwoWay}" PasswordChar="●" MaxLength="72" IsEnabled="{Binding CanEdit}"/>
     <TextBlock Text="Новий пароль" Classes="label"/><TextBox Text="{Binding NewPassword,Mode=TwoWay}" PasswordChar="●" MaxLength="72" IsEnabled="{Binding CanEdit}"/>
     <TextBlock Text="Повторіть новий пароль" Classes="label"/><TextBox Text="{Binding Confirmation,Mode=TwoWay}" PasswordChar="●" MaxLength="72" IsEnabled="{Binding CanEdit}"/>
     <TextBlock Text="Від 8 символів. Після зміни інші сеанси завершаться." Classes="muted" FontSize="12" TextWrapping="Wrap"/>
     <Button Content="Змінити пароль" Classes="primary" Command="{Binding PasswordCommand}"/>
    </StackPanel></Border>
   </Grid>
   <Border BorderBrush="#F0B4B7" BorderThickness="1" CornerRadius="8" Padding="18"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
    <StackPanel Spacing="6"><TextBlock Text="Видалення облікового запису" FontWeight="SemiBold" FontSize="18"/><TextBlock Text="Остаточне видалення особистих даних. Перед підтвердженням ви побачите наслідки для дощок." Classes="muted" FontSize="12" TextWrapping="Wrap"/></StackPanel>
    <Button Grid.Column="1" Name="BeginDeleteAccountButton" Content="Видалити мій аккаунт" Classes="danger" Command="{Binding BeginDeleteAccountCommand}" VerticalAlignment="Center"/>
   </Grid></Border>
  </StackPanel>
 </ScrollViewer>
 <Border Classes="overlay" IsVisible="{Binding DeleteAccountVisible}">
  <Border Classes="modal" MaxWidth="740" MaxHeight="690" Padding="24"><Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
   <StackPanel Spacing="8"><TextBlock Text="Видалити мій аккаунт назавжди?" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Цю дію неможливо скасувати." Foreground="#C83E46"/></StackPanel>
   <ScrollViewer Grid.Row="1"><StackPanel Spacing="12">
    <TextBlock Text="Ваш email, ім’я, пароль і фото профілю буде видалено. Усі сеанси завершаться." TextWrapping="Wrap"/>
    <TextBlock Text="Спільні дошки та картки залишаться. Ваші коментарі збережуться від імені «Видалений користувач». Дошки без інших учасників буде видалено разом із вмістом." TextWrapping="Wrap"/>
    <TextBlock Text="{Binding DeletionMemberships}" Classes="muted" TextWrapping="Wrap"/>
    <StackPanel IsVisible="{Binding HasDeletionBoards}" Spacing="8"><TextBlock Text="Ваші дошки" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding DeletionBoards}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:AccountDeletionImpactViewModel"><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
    <TextBlock Text="Для підтвердження введіть цей email:" Classes="label"/><TextBlock Text="{Binding DeleteAccountEmail}" FontWeight="SemiBold"/>
    <TextBox Name="DeleteAccountEmailInput" Text="{Binding DeleteEmail,Mode=TwoWay}" Watermark="Ваш поточний email" IsEnabled="{Binding !IsBusy}" MaxLength="254"/>
    <TextBlock Text="Поточний пароль" Classes="label"/><TextBox Name="DeleteAccountPasswordInput" Text="{Binding DeletePassword,Mode=TwoWay}" PasswordChar="●" IsEnabled="{Binding !IsBusy}" MaxLength="72"/>
   </StackPanel></ScrollViewer>
   <StackPanel Grid.Row="2" Spacing="12"><TextBlock Text="{Binding Error}" Classes="error" IsVisible="{Binding HasError}"/><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12"><TextBlock Text="Зачекайте…" IsVisible="{Binding IsBusy}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Скасувати" Command="{Binding CancelDeleteAccountCommand}"/><Button Grid.Column="2" Name="ConfirmDeleteAccountButton" Content="Видалити назавжди" Classes="danger" Command="{Binding ConfirmDeleteAccountCommand}"/></Grid></StackPanel>
  </Grid></Border>
 </Border>
 </Grid>
</UserControl>
