<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Curs.ViewModels" xmlns:views="using:Curs.Views" x:Class="Curs.Views.ProfileView" x:DataType="vm:ProfileViewModel">
 <ScrollViewer><StackPanel MaxWidth="900" Margin="32" Spacing="24" HorizontalAlignment="Stretch">
  <StackPanel Spacing="6"><TextBlock Text="Мій профіль" Classes="heading"/><TextBlock Text="Особисті дані, фото та безпека облікового запису" Classes="muted"/></StackPanel>
  <TextBlock Text="{Binding Error}" Classes="error"/><TextBlock Text="{Binding Status}" Classes="success"/><Button Content="Скасувати незбережені зміни" Command="{Binding ResetCommand}" HorizontalAlignment="Left"/>
  <Border Classes="surface" Padding="24"><StackPanel Spacing="18">
   <TextBlock Text="Фото профілю" FontWeight="SemiBold" FontSize="18"/>
   <Grid ColumnDefinitions="90,*" ColumnSpacing="24"><views:AvatarView DataContext="{Binding Avatar}" Width="88" Height="88"/><StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Змінити фото" Click="ChooseAvatar" IsEnabled="{Binding CanEdit}"/><Button Content="Прибрати" Command="{Binding DeleteAvatarCommand}"/></StackPanel><TextBlock Text="JPG, PNG, WEBP · до 5 МіБ" Classes="muted" FontSize="12"/></StackPanel></Grid>
  </StackPanel></Border>
  <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
   <Border Classes="surface" Padding="24"><StackPanel Spacing="14"><TextBlock Text="Особисті дані" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Ім’я" Classes="label"/><TextBox Name="ProfileNameInput" Text="{Binding Name,Mode=TwoWay}" MaxLength="100" IsEnabled="{Binding CanEdit}"/><TextBlock Text="Email" Classes="label"/><TextBox Name="ProfileEmailInput" Text="{Binding Email,Mode=TwoWay}" MaxLength="254" IsEnabled="{Binding CanEdit}"/><TextBlock Text="Для зміни email введіть поточний пароль нижче." Classes="muted" FontSize="12" TextWrapping="Wrap"/><Button Content="Зберегти профіль" Classes="primary" Command="{Binding SaveCommand}"/></StackPanel></Border>
   <Border Grid.Column="1" Classes="surface" Padding="24"><StackPanel Spacing="14"><TextBlock Text="Змінити пароль" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Поточний пароль" Classes="label"/><TextBox Name="CurrentPasswordInput" Text="{Binding CurrentPassword,Mode=TwoWay}" PasswordChar="●" MaxLength="72" IsEnabled="{Binding CanEdit}"/><TextBlock Text="Новий пароль" Classes="label"/><TextBox Text="{Binding NewPassword,Mode=TwoWay}" PasswordChar="●" MaxLength="72" IsEnabled="{Binding CanEdit}"/><TextBlock Text="Повторіть новий пароль" Classes="label"/><TextBox Text="{Binding Confirmation,Mode=TwoWay}" PasswordChar="●" MaxLength="72" IsEnabled="{Binding CanEdit}"/><TextBlock Text="Від 8 символів. Після зміни інші сеанси завершаться." Classes="muted" FontSize="12" TextWrapping="Wrap"/><Button Content="Змінити пароль" Command="{Binding PasswordCommand}"/></StackPanel></Border>
  </Grid>
 </StackPanel></ScrollViewer>
</UserControl>
