<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Curs.ViewModels" x:Class="Curs.Views.CalendarView" x:DataType="vm:CalendarViewModel">
 <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="26,24">
  <StackPanel Spacing="6" Margin="0,0,0,20"><TextBlock Text="Календар задач" Classes="heading"/><TextBlock Text="Дедлайни ваших дощок" Classes="muted"/></StackPanel>
  <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,18" ColumnSpacing="14"><StackPanel Orientation="Horizontal" Spacing="6"><Button Content="‹" Command="{Binding PreviousCommand}"/><Button Content="›" Command="{Binding NextCommand}"/><Button Content="Сьогодні" Command="{Binding TodayCommand}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Heading}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"><Button Content="Тиждень" Classes.active="{Binding IsWeek}" Command="{Binding WeekCommand}"/><Button Content="Місяць" Classes.active="{Binding IsMonth}" Command="{Binding MonthCommand}"/><ComboBox Width="190" ItemsSource="{Binding Assignees}" SelectedItem="{Binding Assignee,Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/><Button Content="↻" Command="{Binding RefreshCommand}" ToolTip.Tip="Оновити календар"/></StackPanel></Grid>
  <ScrollViewer Grid.Row="2" Name="CalendarScroll" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14">
   <ItemsControl ItemsSource="{Binding Weekdays}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" HorizontalAlignment="Center" Classes="muted"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <ItemsControl ItemsSource="{Binding Days}" Name="CalendarDays"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:CalendarDayViewModel"><Border Tag="CalendarDay" Background="{Binding Background}" BorderBrush="#E2E7EE" BorderThickness="0.5" Padding="8" Height="{Binding Height}" ToolTip.Tip="{Binding AccessibleDate}"><Grid RowDefinitions="Auto,*"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" Margin="2,0,0,6"/><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource CalendarTask}"/></ScrollViewer></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="У цьому періоді немає карток. Змініть фільтр або дати." IsVisible="{Binding NoTasks}" Classes="muted" TextWrapping="Wrap"/>
   <Border Tag="CalendarUndated" BorderBrush="#E2E7EE" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel Spacing="10"><TextBlock Text="{Binding UndatedHeading}" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Undated}" ItemTemplate="{StaticResource CalendarTask}"/><TextBlock Text="Перетягніть сюди, щоб прибрати дедлайн." Classes="muted" FontSize="11"/></StackPanel></Border>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="3" Spacing="4" Margin="0,12,0,0"><TextBlock Text="Перетягніть картку за ⠿ на іншу дату · Натисніть назву, щоб відкрити" Classes="muted" FontSize="11"/><TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" Classes="success"/></StackPanel>
 </Grid>
 <UserControl.Resources><DataTemplate x:Key="CalendarTask" x:DataType="vm:CalendarTaskViewModel"><Border Background="{Binding Color}" CornerRadius="6" Padding="7" Margin="0,0,0,6"><Grid ColumnDefinitions="18,*"><Border Background="Transparent" Cursor="SizeAll" PointerPressed="DragPressed" PointerMoved="DragMoved" PointerReleased="DragReleased" PointerCaptureLost="DragLost" ToolTip.Tip="Перетягніть дедлайн"><TextBlock Text="⠿" Foreground="#58718B"/></Border><StackPanel Grid.Column="1" Spacing="3"><Button Command="{Binding OpenCommand}" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/></Button><TextBlock Text="{Binding Context}" FontSize="10" Classes="muted" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Assignee}" FontSize="10" Classes="muted" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border></DataTemplate></UserControl.Resources>
 <UserControl.Styles><Style Selector="Button.active"><Setter Property="Background" Value="#DDF3F1"/><Setter Property="Foreground" Value="#168C98"/></Style><Style Selector="Border.calendar-over"><Setter Property="BorderBrush" Value="#168C98"/><Setter Property="BorderThickness" Value="2"/></Style></UserControl.Styles>
</UserControl>
