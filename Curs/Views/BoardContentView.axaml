<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Curs.ViewModels" xmlns:views="using:Curs.Views" xmlns:contracts="using:KanbanContracts" x:Class="Curs.Views.BoardContentView" x:DataType="vm:BoardContentViewModel">
 <Grid RowDefinitions="Auto,*,Auto">
  <Grid ColumnDefinitions="2.5*,1.1*,1*,1.4*,1.1*,Auto" ColumnSpacing="12" Margin="0,0,0,18">
   <TextBox Text="{Binding Search,Mode=TwoWay}" Watermark="⌕   Пошук карток" MaxLength="200" IsEnabled="{Binding CanFilter}"/>
   <ComboBox Grid.Column="1" ItemsSource="{Binding PriorityFilters}" SelectedItem="{Binding FilterPriority,Mode=TwoWay}" IsEnabled="{Binding CanFilter}"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PriorityFilterOption"><TextBlock Text="{Binding Name}" FontSize="12"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
   <ComboBox Grid.Column="2" ItemsSource="{Binding TagFilters}" SelectedItem="{Binding FilterTag,Mode=TwoWay}" IsEnabled="{Binding CanFilter}"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:TagFilterOption"><TextBlock Text="{Binding Name}" FontSize="12"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
   <ComboBox Grid.Column="3" ItemsSource="{Binding AssigneeFilters}" SelectedItem="{Binding FilterAssignee,Mode=TwoWay}" IsEnabled="{Binding CanFilter}"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:AssigneeOption"><TextBlock Text="{Binding Name}" FontSize="12"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
   <ComboBox Grid.Column="4" ItemsSource="{Binding DeadlineFilters}" SelectedItem="{Binding FilterDeadline,Mode=TwoWay}" IsEnabled="{Binding CanFilter}"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:DeadlineFilterOption"><TextBlock Text="{Binding Name}" FontSize="12"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
   <Button Grid.Column="5" Content="Скинути" Command="{Binding ResetFiltersCommand}"/>
  </Grid>
  <ScrollViewer Grid.Row="1" Name="ColumnsScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" SizeChanged="ColumnsSizeChanged">
   <StackPanel Orientation="Horizontal" Spacing="10">
    <ItemsControl ItemsSource="{Binding Columns}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ColumnItemViewModel">
     <Border Width="{Binding $parent[UserControl].((vm:BoardContentViewModel)DataContext).ColumnWidth}" Background="{Binding Background}" CornerRadius="8" Padding="9" Tag="ColumnDropTarget">
      <Grid RowDefinitions="Auto,Auto,*">
       <Grid ColumnDefinitions="*,Auto" Margin="4,0,0,8"><StackPanel Orientation="Horizontal" Spacing="10" PointerPressed="DragPressed" PointerMoved="DragMoved" PointerReleased="DragReleased" PointerCaptureLost="DragCaptureLost" Cursor="SizeAll"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" MaxWidth="170" TextTrimming="CharacterEllipsis"/><Border Background="#DDE5F0" CornerRadius="12" Padding="7,2" VerticalAlignment="Center"><TextBlock Text="{Binding Count}" FontSize="11" Foreground="#65738A"/></Border></StackPanel><Button Grid.Column="1" Classes="icon" Content="⋮" Command="{Binding SelectCommand}" ToolTip.Tip="Керувати колонкою"/></Grid>
       <Button Grid.Row="1" Content="＋  Картка" Command="{Binding AddCommand}" IsVisible="{Binding CanCreate}" Foreground="#168593" Background="#F8FCFF" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,10"/>
       <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Cards}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:CardItemViewModel">
        <Border Classes="surface" Padding="10" Margin="0,0,0,9" CornerRadius="7" Tag="CardDropTarget" DragDrop.AllowDrop="True" DragDrop.DragOver="CoverDragOver" DragDrop.DragLeave="CoverDragLeave" DragDrop.Drop="CoverDrop" ToolTip.Tip="Перетягніть файл фото на картку, щоб змінити обкладинку" AttachedToVisualTree="CoverAttached" PointerPressed="DragPressed" PointerMoved="DragMoved" PointerReleased="DragReleased" PointerCaptureLost="DragCaptureLost" DoubleTapped="OpenCard" Cursor="Hand">
         <StackPanel Spacing="7">
          <Border CornerRadius="5" ClipToBounds="True" IsVisible="{Binding HasImage}"><Image Source="{Binding Thumbnail}" Height="88" Stretch="UniformToFill"/></Border>
          <Grid ColumnDefinitions="*,24"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="14"/><Button Grid.Column="1" Classes="icon" Width="24" MinHeight="20" Height="20" Content="⋮" Command="{Binding OpenCommand}" ToolTip.Tip="Відкрити картку"/></Grid>
          <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" Classes="muted" FontSize="12" LineHeight="16"/>
          <WrapPanel><Border Background="{Binding PriorityBackground}" CornerRadius="12" Padding="9,4" Margin="0,0,5,5"><TextBlock Text="{Binding Priority}" Foreground="{Binding PriorityForeground}" FontWeight="SemiBold" FontSize="11"/></Border><ItemsControl ItemsSource="{Binding TagItems}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:TagPillViewModel"><Border Background="{Binding Background}" CornerRadius="5" Padding="7,4" Margin="0,0,5,5"><TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}" FontSize="10"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></WrapPanel>
          <StackPanel IsVisible="{Binding HasChecklist}" Spacing="5"><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="☑" Foreground="#168C98" FontSize="12"/><TextBlock Text="{Binding ChecklistLabel}" FontSize="11" Foreground="#168C98"/></StackPanel><ProgressBar Value="{Binding ChecklistPercent}" Maximum="100" Height="4" Foreground="#168C98" Background="#E4E9F1"/></StackPanel>
          <Grid ColumnDefinitions="*,Auto,34" ColumnSpacing="12" Margin="0,2,0,0"><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Width="13" Height="13" Foreground="{Binding DateForeground}" Data="M0,2 L14,2 14,16 0,16 Z M2,6 L2,14 12,14 12,6 Z M3,0 L5,0 5,4 3,4 Z M9,0 L11,0 11,4 9,4 Z"/><TextBlock Text="{Binding DateLabel}" Foreground="{Binding DateForeground}" FontSize="10"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"><PathIcon Width="14" Height="14" Foreground="#78869D" Data="M7,0 C-3,0 -3,12 4,12 L1,16 9,12 C18,10 17,0 7,0 M7,2 C15,2 15,10 7,10 L5,10 5,10 C-1,10 -1,2 7,2 Z"/><TextBlock Text="{Binding CommentCount}" FontSize="10" Classes="muted"/></StackPanel><Border Grid.Column="2" IsVisible="{Binding HasAssignee}"><views:AvatarView DataContext="{Binding Avatar}" Width="30" Height="30" AttachedToVisualTree="AvatarAttached"/></Border></Grid>
         </StackPanel>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      </Grid>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Border Tag="ColumnsEndDropTarget" Background="#F8FAFC" BorderBrush="#DCE4ED" BorderThickness="1" CornerRadius="7" Width="80"><Button Classes="ghost" Command="{Binding ShowNewColumnCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Top" Padding="0,20"><StackPanel Spacing="8"><TextBlock Text="＋" FontSize="25" HorizontalAlignment="Center"/><TextBlock Text="Колонка" FontSize="11"/></StackPanel></Button></Border>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,5,0,0" Spacing="2"><TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Classes="error" FontSize="12"/><TextBlock Text="{Binding Status}" Classes="success" FontSize="11"/><TextBlock Text="{Binding SyncMessage}" Classes="muted" FontSize="10" IsVisible="{Binding RemoteChangesPending}"/></StackPanel>
 </Grid>
</UserControl>
