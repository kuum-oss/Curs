<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Curs.ViewModels" x:Class="Curs.Views.BoardContentView" x:DataType="vm:BoardContentViewModel">
    <StackPanel Spacing="12">
        <TextBlock IsVisible="{Binding HasError}" Text="{Binding Error}" TextWrapping="Wrap" Foreground="#B42318" />
        <StackPanel Spacing="16" IsVisible="{Binding IsVisible}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Колонки та картки" FontSize="24" FontWeight="SemiBold" />
                <Button Grid.Column="1" Content="Оновити вміст" Command="{Binding RefreshCommand}" />
            </Grid>
            <TextBlock Text="Завантаження…" IsVisible="{Binding IsBusy}" />
            <TextBlock Text="{Binding Status}" Foreground="#237A4B" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SyncMessage}" TextWrapping="Wrap" Foreground="#58677D" />
            <TextBlock Text="Перетягуйте заголовки колонок або картки, щоб змінити порядок. Для цього закрийте редактор." TextWrapping="Wrap" Foreground="#58677D" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="450">
                <ItemsControl ItemsSource="{Binding Columns}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ColumnItemViewModel">
                            <Border Width="280" Background="#EDF3FF" Padding="14" Margin="0,0,14,0" CornerRadius="10"
                                    Tag="ColumnDropTarget">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Cursor="SizeAll"
                                               PointerPressed="DragPressed" PointerMoved="DragMoved" PointerReleased="DragReleased" PointerCaptureLost="DragCaptureLost" />
                                    <Button Content="Керувати колонкою" Command="{Binding SelectCommand}" />
                                    <Button Content="+ Картка" Command="{Binding AddCommand}" IsVisible="{Binding CanCreate}" />
                                    <ScrollViewer MaxHeight="280">
                                        <ItemsControl ItemsSource="{Binding Cards}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CardItemViewModel">
                                                    <Border Background="White" Padding="12" Margin="0,0,0,10" CornerRadius="8"
                                                            PointerPressed="DragPressed" PointerMoved="DragMoved" PointerReleased="DragReleased" PointerCaptureLost="DragCaptureLost"
                                                            Tag="CardDropTarget">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#58677D" />
                                                            <TextBlock Text="{Binding Tags}" TextWrapping="Wrap" Foreground="#234E8D" />
                                                            <Button Content="Відкрити картку" Command="{Binding OpenCommand}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Background="#EDF3FF" Padding="12" CornerRadius="8" Tag="ColumnsEndDropTarget">
                <TextBlock Text="Перетягніть колонку сюди, щоб поставити її в кінці." TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="Нова колонка" FontSize="18" FontWeight="SemiBold" />
            <TextBox Text="{Binding NewColumnName,Mode=TwoWay}" Watermark="Назва колонки" MaxLength="100" IsEnabled="{Binding CanEdit}" />
            <Button Content="Створити колонку" Command="{Binding CreateColumnCommand}" />
            <Border IsVisible="{Binding HasColumn}" BorderBrush="#D7E1EF" BorderThickness="1" Padding="16" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Text="Вибрана колонка" FontWeight="SemiBold" />
                    <TextBox Text="{Binding ColumnName,Mode=TwoWay}" MaxLength="100" IsEnabled="{Binding CanEdit}" />
                    <WrapPanel>
                        <Button Content="Перейменувати" Command="{Binding RenameColumnCommand}" Margin="0,0,12,0" />
                        <Button Content="Видалити колонку" Command="{Binding DeleteColumnCommand}" IsVisible="{Binding CanDeleteColumn}" Foreground="#B42318" />
                        <Button Content="Закрити редагування" Command="{Binding CloseEditorCommand}" Margin="12,0,0,0" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border IsVisible="{Binding EditorVisible}" Background="#F5F7FC" Padding="20" CornerRadius="10">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding EditorHeading}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Назва" />
                    <TextBox Text="{Binding Title,Mode=TwoWay}" MaxLength="200" IsEnabled="{Binding CanEdit}" />
                    <TextBlock Text="Опис" />
                    <TextBox Text="{Binding Description,Mode=TwoWay}" MaxLength="10000" AcceptsReturn="True" Height="100" IsEnabled="{Binding CanEdit}" />
                    <TextBlock Text="Дедлайн (РРРР-ММ-ДД, необов’язково)" />
                    <TextBox Text="{Binding DueDate,Mode=TwoWay}" Watermark="2026-12-31" MaxLength="10" IsEnabled="{Binding CanEdit}" />
                    <TextBlock Text="Пріоритет" />
                    <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority,Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                    <TextBlock Text="Відповідальний" />
                    <ComboBox ItemsSource="{Binding Assignees}" SelectedItem="{Binding Assignee,Mode=TwoWay}" IsEnabled="{Binding CanEdit}">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:AssigneeOption"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Теги" />
                    <ItemsControl ItemsSource="{Binding Tags}" IsEnabled="{Binding CanEdit}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:TagChoiceViewModel"><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected,Mode=TwoWay}" Margin="0,0,18,0" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Text="{Binding TagName,Mode=TwoWay}" Watermark="Назва нового тегу" MaxLength="50" IsEnabled="{Binding CanEdit}" />
                    <TextBox Text="{Binding TagColor,Mode=TwoWay}" Watermark="#64748B" MaxLength="7" IsEnabled="{Binding CanEdit}" />
                    <Button Content="Створити тег" Command="{Binding CreateTagCommand}" />
                    <WrapPanel>
                        <Button Content="Зберегти картку" Command="{Binding SaveCardCommand}" Background="#2563EB" Foreground="White" Margin="0,0,12,0" />
                        <Button Content="Закрити редактор" Command="{Binding CloseEditorCommand}" Margin="0,0,12,0" />
                        <Button Content="Видалити картку" Command="{Binding DeleteCardCommand}" IsVisible="{Binding CanDeleteCard}" Foreground="#B42318" />
                    </WrapPanel>
                    <StackPanel Spacing="10" IsVisible="{Binding ExistingCard}">
                        <TextBlock Text="Коментарі" FontSize="20" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Comments}">
                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:CommentItemViewModel">
                                <Border Background="White" Padding="12" Margin="0,0,0,8" CornerRadius="8"><StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                </StackPanel></Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Text="{Binding CommentText,Mode=TwoWay}" Watermark="Новий коментар" MaxLength="4000" AcceptsReturn="True" Height="70" IsEnabled="{Binding CanEdit}" />
                        <Button Content="Додати коментар" Command="{Binding AddCommentCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border IsVisible="{Binding ShowConfirmation}" Background="#FFF1EC" Padding="18" CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding ConfirmationText}" TextWrapping="Wrap" Foreground="#B42318" />
                    <WrapPanel><Button Content="Підтвердити видалення" Command="{Binding ConfirmCommand}" Margin="0,0,12,0" /><Button Content="Скасувати" Command="{Binding CancelCommand}" /></WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
