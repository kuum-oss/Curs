<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Curs.ViewModels" xmlns:views="using:Curs.Views" x:Class="Curs.Views.ChatView" x:DataType="vm:ChatViewModel">
 <Grid RowDefinitions="Auto,*" Margin="28,24">
  <StackPanel Spacing="6" Margin="0,0,0,20"><TextBlock Text="Особисті повідомлення" Classes="heading"/><TextBlock Text="Ваші розмови з учасниками команди" Classes="muted"/></StackPanel>
  <Border Grid.Row="1" Classes="surface" ClipToBounds="True">
   <Grid ColumnDefinitions="280,*">
    <Border BorderBrush="#E2E7EE" BorderThickness="0,0,1,0" Background="#FAFCFD"><ScrollViewer><StackPanel>
     <TextBlock Text="Розмови" FontWeight="SemiBold" Margin="18"/>
     <TextBlock Text="Щоб почати розмову, відкрийте «Команда» та натисніть «Чат» біля учасника." IsVisible="{Binding NoChats}" Classes="muted" TextWrapping="Wrap" Margin="18"/>
     <ItemsControl ItemsSource="{Binding Threads}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ChatThreadViewModel"><Button Command="{Binding OpenCommand}" Classes="nav" Padding="14" HorizontalAlignment="Stretch"><Grid ColumnDefinitions="38,*,Auto" ColumnSpacing="10"><views:AvatarView DataContext="{Binding Avatar}" Width="36" Height="36"/><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Preview}" Classes="muted" FontSize="12" MaxLines="1" TextTrimming="CharacterEllipsis"/></StackPanel><Border Grid.Column="2" Background="#168C98" CornerRadius="12" Padding="7,3" IsVisible="{Binding HasUnread}"><TextBlock Text="{Binding Unread}" Foreground="White" FontSize="11"/></Border></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer></Border>
    <Grid Grid.Column="1">
     <StackPanel IsVisible="{Binding NoConversation}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360" Spacing="12"><TextBlock Text="Поговорімо про важливе" FontSize="23" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Оберіть розмову зліва або почніть нову на сторінці «Команда»." Classes="muted" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel>
     <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding HasConversation}">
      <Border BorderBrush="#E2E7EE" BorderThickness="0,0,0,1" Padding="22,16"><StackPanel Spacing="4"><TextBlock Text="{Binding PeerName}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding PeerEmail}" Classes="muted" FontSize="12"/></StackPanel></Border>
      <ScrollViewer Grid.Row="1" Name="MessageScroll" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="22,16" Spacing="12"><Button Content="Попередні повідомлення" Command="{Binding OlderCommand}" IsVisible="{Binding HasOlder}" HorizontalAlignment="Center"/>
       <TextBlock Text="Тут починається ваша розмова." IsVisible="{Binding NoMessages}" Classes="muted" HorizontalAlignment="Center"/>
       <ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ChatMessageViewModel"><Border HorizontalAlignment="{Binding Alignment}" Background="{Binding Background}" CornerRadius="13" Padding="14,10" Margin="0,4" MaxWidth="520"><StackPanel Spacing="5"><TextBlock Text="{Binding Author}" Classes="muted" FontSize="10"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap"/><Border Classes="surface" IsVisible="{Binding HasSharedCard}" Background="White" Padding="14" MinWidth="240" Margin="0,6"><StackPanel Spacing="8"><TextBlock Text="▥  Картка" Foreground="#168C98" FontSize="11"/><TextBlock Text="{Binding SharedTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SharedContext}" Classes="muted" FontSize="11" TextWrapping="Wrap"/><Button Content="{Binding SharedOpenLabel}" Command="{Binding OpenSharedCommand}" Foreground="#168C98" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/></StackPanel></Border><TextBlock Text="{Binding Time}" Classes="muted" FontSize="10" HorizontalAlignment="Right"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></ScrollViewer>
      <Border Grid.Row="2" Padding="18" BorderBrush="#E2E7EE" BorderThickness="0,1,0,0"><StackPanel Spacing="9"><TextBlock Text="Користувач зараз недоступний. Історія розмови збережена." IsVisible="{Binding PeerUnavailable}" Classes="muted" TextWrapping="Wrap"/><Button Name="ShareCardButton" Content="▥  Поділитися карткою" Command="{Binding ShareCommand}" Foreground="#168C98" HorizontalAlignment="Left"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBox Name="ChatDraftInput" Text="{Binding Draft,Mode=TwoWay}" Watermark="Напишіть повідомлення…" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="130" IsEnabled="{Binding CanSend}"/><Button Grid.Column="1" Name="SendChatButton" Content="Надіслати" Classes="primary" Command="{Binding SendCommand}" VerticalAlignment="Bottom"/></Grid><TextBlock Text="До 2000 символів · Enter — новий рядок" Classes="muted" FontSize="11"/></StackPanel></Border>
     </Grid>
    </Grid>
   </Grid>
  </Border>
  <Border IsVisible="{Binding HasError}" Grid.RowSpan="2" VerticalAlignment="Bottom" Margin="300,0,12,0" Background="White" Padding="8" IsHitTestVisible="False"><TextBlock Text="{Binding Error}" Classes="error"/></Border>
  <Border Grid.RowSpan="2" Classes="overlay" IsVisible="{Binding ShareVisible}"><Border Classes="modal" Width="560" MaxHeight="620" Padding="24"><Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="14">
   <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Поділитися карткою" FontSize="24" FontWeight="SemiBold"/><Button Grid.Column="1" Content="×" Classes="icon" Command="{Binding CloseShareCommand}"/></Grid>
   <StackPanel Grid.Row="1" Spacing="7"><TextBlock Text="Дошка" Classes="label"/><ComboBox ItemsSource="{Binding ShareBoards}" SelectedItem="{Binding SelectedShareBoard,Mode=TwoWay}" IsEnabled="{Binding CanChooseShare}"/></StackPanel>
   <TextBox Grid.Row="2" Text="{Binding ShareSearch,Mode=TwoWay}" Watermark="Пошук карток" MaxLength="200" IsEnabled="{Binding CanChooseShare}"/>
   <Grid Grid.Row="3"><ListBox Name="ShareCardChoices" ItemsSource="{Binding VisibleShareCards}" SelectedItem="{Binding SelectedShareCard,Mode=TwoWay}" MaxHeight="260" MinHeight="140" IsEnabled="{Binding CanChooseShare}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:ShareCardOption"><StackPanel Spacing="5" Margin="6"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Context}" Classes="muted" FontSize="12" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="Карток не знайдено. Оберіть іншу дошку або змініть пошук." IsVisible="{Binding NoShareCards}" Classes="muted" TextWrapping="Wrap" Margin="15"/></Grid>
   <StackPanel Grid.Row="4" Spacing="8"><TextBlock Text="Доступ до дошки перевіряється при відкритті. Надсилання не надає доступу." Classes="muted" TextWrapping="Wrap" FontSize="11"/><TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap"/></StackPanel>
   <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12"><Button Content="Скасувати" Command="{Binding CloseShareCommand}"/><Button Name="ConfirmShareCardButton" Content="Поділитися" Classes="primary" Command="{Binding ShareSendCommand}"/></StackPanel>
  </Grid></Border></Border>
 </Grid>
</UserControl>
