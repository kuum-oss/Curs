<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Curs.ViewModels" xmlns:views="using:Curs.Views" x:Class="Curs.Views.ActivityListView" x:DataType="vm:HistoryViewModel">
 <Grid RowDefinitions="Auto,Auto,*">
  <Grid ColumnDefinitions="2*,1.2*,1*,1*" ColumnSpacing="10" Margin="0,0,0,16">
   <TextBox Name="HistorySearch" Text="{Binding Search,Mode=TwoWay}" Watermark="Пошук подій" MaxLength="100"/>
   <ComboBox Grid.Column="1" ItemsSource="{Binding People}" SelectedItem="{Binding Person,Mode=TwoWay}"/>
   <ComboBox Grid.Column="2" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind,Mode=TwoWay}"/>
   <ComboBox Grid.Column="3" ItemsSource="{Binding Periods}" SelectedItem="{Binding Period,Mode=TwoWay}"/>
  </Grid>
  <StackPanel Grid.Row="1" Spacing="8"><ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}" Height="3"/><TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap"/><TextBlock IsVisible="{Binding Empty}" Text="Подій за цей період немає. Історія накопичується з моменту ввімкнення функції." Classes="muted" TextWrapping="Wrap"/></StackPanel>
  <ScrollViewer Grid.Row="2"><StackPanel Spacing="12"><ItemsControl ItemsSource="{Binding Events}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ActivityViewModel">
   <Border BorderBrush="#EDF0F5" BorderThickness="0,0,0,1" Padding="12,16"><StackPanel Spacing="10"><TextBlock IsVisible="{Binding ShowDay}" Text="{Binding Day}" FontWeight="SemiBold" FontSize="12" Classes="muted"/>
    <Grid ColumnDefinitions="12,38,*,Auto" ColumnSpacing="12"><Border Width="7" Height="7" Background="{Binding Accent}" CornerRadius="7" VerticalAlignment="Top" Margin="0,10,0,0"/><views:AvatarView Grid.Column="1" DataContext="{Binding Avatar}" Width="36" Height="36" VerticalAlignment="Top"/>
     <StackPanel Grid.Column="2" Spacing="7"><WrapPanel><TextBlock Text="{Binding Actor}" FontWeight="SemiBold" Margin="0,0,6,0"/><TextBlock Text="{Binding Action}" Classes="muted" TextWrapping="Wrap"/></WrapPanel>
      <Button Classes="ghost" Command="{Binding OpenCommand}" HorizontalAlignment="Left" Padding="0" MinHeight="22" Foreground="#1595AA" MaxWidth="700"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="12"/></Button>
      <Grid ColumnDefinitions="80,*,20,*" ColumnSpacing="8"><TextBlock Text="{Binding Field}" Classes="muted" FontSize="12"/><Border Grid.Column="1" Background="#EFF3F9" CornerRadius="5" Padding="9,5"><TextBlock Text="{Binding Before}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" FontSize="12" ToolTip.Tip="{Binding Before}"/></Border><TextBlock Grid.Column="2" Text="→" Classes="muted"/><Border Grid.Column="3" Background="{Binding AfterBackground}" CornerRadius="5" Padding="9,5"><TextBlock Text="{Binding After}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" FontSize="12" ToolTip.Tip="{Binding After}"/></Border></Grid>
     </StackPanel><TextBlock Grid.Column="3" Text="{Binding Time}" Classes="muted" FontSize="11" VerticalAlignment="Top"/>
    </Grid></StackPanel></Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Показати ще" Command="{Binding MoreCommand}" IsVisible="{Binding HasMore}" HorizontalAlignment="Stretch"/><Button Content="Оновити історію" Command="{Binding RefreshCommand}" HorizontalAlignment="Left"/></StackPanel></ScrollViewer>
 </Grid>
</UserControl>
