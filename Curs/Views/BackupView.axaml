<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Curs.ViewModels" x:Class="Curs.Views.BackupView" x:DataType="vm:BackupViewModel">
 <ScrollViewer><StackPanel Margin="28,24" Spacing="20">
  <StackPanel Spacing="7"><TextBlock Text="Резервні копії та експорт" Classes="heading"/><TextBlock Text="Збережіть дошку у файл або відновіть її копію." Classes="muted" TextWrapping="Wrap"/></StackPanel>
  <StackPanel Spacing="8"><TextBlock Text="Дошка" Classes="label"/><ComboBox ItemsSource="{Binding Boards}" SelectedItem="{Binding SelectedBoard,Mode=TwoWay}" IsEnabled="{Binding CanEdit}" MaxWidth="620" HorizontalAlignment="Left" MinWidth="300"/></StackPanel>
  <Grid ColumnDefinitions="*,*" ColumnSpacing="18"><Border Classes="surface" Padding="22"><StackPanel Spacing="14"><TextBlock Text="Резервна копія" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Колонки та всі картки, фото, теги, чек-листи й коментарі." Classes="muted" TextWrapping="Wrap"/><Button Content="Зберегти копію" Name="SaveBackupButton" Classes="primary" Click="SaveBackup" IsEnabled="{Binding CanExport}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/></StackPanel></Border><Border Grid.Column="1" Classes="surface" Padding="22"><StackPanel Spacing="14"><TextBlock Text="Експорт CSV" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Список усіх задач вибраної дошки, включно з архівними." Classes="muted" TextWrapping="Wrap"/><Button Content="Експортувати CSV" Name="ExportCsvButton" Click="SaveCsv" IsEnabled="{Binding CanExport}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Foreground="#168C98"/></StackPanel></Border></Grid>
  <Border Classes="surface" Padding="22"><StackPanel Spacing="15"><TextBlock Text="Відновлення" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Буде створено нову дошку. Існуючі дані збережуться." Classes="muted"/><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Button Content="Вибрати файл копії" Name="ChooseBackupButton" Click="ChooseBackup" IsEnabled="{Binding CanEdit}"/><TextBlock Grid.Column="1" Text="{Binding Filename}" Classes="muted" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" Content="×" Command="{Binding ClearFileCommand}" IsVisible="{Binding HasDocument}"/></Grid><Border Background="#F5F9FC" CornerRadius="8" Padding="16"><TextBlock Text="{Binding Preview}" TextWrapping="Wrap"/></Border><TextBlock Text="Учасників потрібно запросити повторно. Імена з копії зберігаються як історичні відомості без призначення та доступу." Classes="muted" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="Копія містить вміст дошки та фото. Зберігайте файл у надійному місці. До 32 МіБ." Classes="muted" FontSize="11" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right"><Button Content="Відкрити дошку" Command="{Binding OpenRestoredCommand}" IsVisible="{Binding HasRestored}"/><Button Content="Відновити як нову дошку" Name="RestoreBackupButton" Classes="primary" Command="{Binding RestoreCommand}"/></StackPanel></StackPanel></Border>
  <TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" Classes="success" TextWrapping="Wrap"/>
 </StackPanel></ScrollViewer>
</UserControl>
