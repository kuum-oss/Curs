# Copy to .env and replace both placeholders before starting Compose.
# Use a strong SQL password (upper/lower case, digits and symbols).
# For connection-string compatibility avoid double quotes and dollar signs.
MSSQL_SA_PASSWORD=replace-with-a-strong-SQL-password
# Generate a key, for example: openssl rand -hex 32
JWT_KEY=replace-with-a-random-key-of-at-least-32-bytes
# Optional; defaults keep all network access on this computer.
API_PORT=5000
SQL_PORT=3038
KANBAN_DATABASE=KanbanDB
